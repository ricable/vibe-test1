# ============================================================================
# Ericsson RAN Swarm Optimizer - Multi-Platform Environment Configuration
# ============================================================================
# Supports: Claude Code Web, E2B Sandboxes, Mac Silicon DevPod (Docker)
# ============================================================================

# ============================================================================
# CORE AI PROVIDER CREDENTIALS (Required)
# ============================================================================

# Anthropic Claude API
ANTHROPIC_API_KEY=${ANTHROPIC_API_KEY}

# OpenRouter API (Multi-model access)
OPENROUTER_API_KEY=${OPENROUTER_API_KEY}

# Google Gemini API
GEMINI_API_KEY=${GEMINI_API_KEY}

# E2B Sandbox API (Required for E2B deployment)
E2B_API_KEY=${E2B_API_KEY}

# ============================================================================
# DEFAULT MODEL CONFIGURATION
# ============================================================================

# Primary AI Model (Claude)
PRIMARY_MODEL=claude-sonnet-4-20250514
PRIMARY_PROVIDER=anthropic

# Secondary AI Model (Gemini)
SECONDARY_MODEL=gemini-2.0-flash-exp
SECONDARY_PROVIDER=google

# Fallback Model (OpenRouter)
FALLBACK_MODEL=anthropic/claude-sonnet-4
FALLBACK_PROVIDER=openrouter

# Model Routing Strategy: adaptive | round-robin | priority | cost-optimized
MODEL_ROUTING_STRATEGY=adaptive

# ============================================================================
# PLATFORM DETECTION (Auto-detected, can override)
# ============================================================================

# Platform: e2b | devpod-silicon | devpod-docker | claude-web | local
PLATFORM=${PLATFORM:-auto}

# Architecture: arm64 | x64
ARCH=${ARCH:-auto}

# ============================================================================
# SWARM CONFIGURATION
# ============================================================================

# Swarm Identity
SWARM_CLUSTER_ID=ericsson-ran-cluster-01
SWARM_NODE_ID=node-${HOSTNAME:-local}
SWARM_TOPOLOGY=mesh

# Federation Settings
FEDERATION_ENABLED=true
FEDERATION_ALGORITHM=FedAvg
FEDERATION_MIN_CLIENTS=3
FEDERATION_ROUND_INTERVAL_MS=300000
FEDERATION_COMPRESSION_ENABLED=true
FEDERATION_COMPRESSION_RATIO=0.1

# Consensus Protocol: strange-loops | raft | gossip | byzantine
CONSENSUS_PROTOCOL=strange-loops
COMMUNICATION_PROTOCOL=QUIC

# ============================================================================
# ERICSSON RAN OPTIMIZATION SETTINGS
# ============================================================================

# Optimization Granularities (comma-separated)
OPTIMIZATION_GRANULARITIES=15min,1hour,1day,1week

# Safety Guardrails
MAX_POWER_DBM=46
MIN_POWER_DBM=-10
MAX_P0_DBM=-60
MIN_P0_DBM=-126
MAX_ALPHA=1.0
MIN_ALPHA=0.4

# RL Agent Settings
RL_ALGORITHM=DecisionTransformer
RL_CONTEXT_LENGTH=20
RL_LEARNING_RATE=0.0001
RL_BATCH_SIZE=64
RL_WARMUP_STEPS=10000

# ============================================================================
# CM - CONFIGURATION MANAGEMENT
# ============================================================================

CM_ENABLED=true
CM_PLANNER=GOAP
CM_SAFETY_VERIFICATION=LTL
CM_ROLLBACK_ENABLED=true
CM_MAX_CONCURRENT_CHANGES=5

# ============================================================================
# PM - PERFORMANCE MANAGEMENT
# ============================================================================

PM_ENABLED=true
PM_CHAOS_DETECTION_ENABLED=true
PM_LYAPUNOV_THRESHOLD=0.05
PM_FORECASTING_MODEL=LSTM
PM_FORECAST_HORIZON_MS=900000
PM_ENERGY_SAVING_ENABLED=true

# ============================================================================
# FM - FAULT MANAGEMENT
# ============================================================================

FM_ENABLED=true
FM_ANOMALY_DETECTION=fast-path
FM_RCA_ENGINE=neuro-symbolic
FM_ALARM_CORRELATION_ENABLED=true
FM_SELF_HEALING_ENABLED=true

# ============================================================================
# GNN CONFIGURATION
# ============================================================================

GNN_ENABLED=true
GNN_TYPE=ST-GNN
GNN_LAYERS=4
GNN_HIDDEN_DIMENSION=256
GNN_ATTENTION_HEADS=8
GNN_ATTENTION_TYPE=flash
GNN_DROPOUT=0.1
GNN_HYPERGRAPH_ENABLED=true

# ============================================================================
# VECTOR DATABASE (RuVector)
# ============================================================================

VECTOR_STORE_ALGORITHM=HNSW
VECTOR_STORE_DIMENSIONS=768
VECTOR_STORE_EF_CONSTRUCTION=200
VECTOR_STORE_M=16
VECTOR_STORE_EF_SEARCH=100

# ============================================================================
# AGENT DATABASE (AgentDB)
# ============================================================================

AGENTDB_STORAGE_TYPE=sqlite
AGENTDB_PATH=./data/agentdb
AGENTDB_MAX_SIZE_MB=512
AGENTDB_MAX_TRAJECTORIES=10000
AGENTDB_REFLEXION_ENABLED=true
AGENTDB_CAUSAL_GRAPH_DEPTH=10

# ============================================================================
# CLAUDE FLOW INTEGRATION
# ============================================================================

CLAUDE_FLOW_ENABLED=true
HIVE_MIND_ENABLED=true
REASONING_BANK_ENABLED=true
SPARC_ENABLED=true

# ============================================================================
# SECURITY SETTINGS
# ============================================================================

# AIDefence Configuration
AIDEFENCE_ENABLED=true
ADVERSARIAL_DETECTION=true
GUARDRAILS_ENABLED=true
MODEL_PROVENANCE=true
INPUT_VALIDATION=true

# Differential Privacy
DP_ENABLED=true
DP_EPSILON=1.0
DP_DELTA=1e-5

# Cryptography
SIGNATURE_ALGORITHM=Ed25519
ENCRYPTION_ALGORITHM=AES-256-GCM

# ============================================================================
# DATABASE CONFIGURATION
# ============================================================================

DATABASE_TYPE=sqlite
DATABASE_PATH=./data/swarm.db

# Redis (Optional - for caching in Docker/DevPod)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ============================================================================
# API SERVER CONFIGURATION
# ============================================================================

API_PORT=3000
API_HOST=0.0.0.0
CORS_ORIGIN=*
API_RATE_LIMIT=100
API_TIMEOUT_MS=30000

# ============================================================================
# MONITORING & LOGGING
# ============================================================================

# Logging Level: debug | info | warn | error
LOG_LEVEL=info
LOG_FORMAT=json

# Metrics
METRICS_PORT=9090
METRICS_ENABLED=true
HEALTH_CHECK_PORT=8080

# Tracing
TRACING_ENABLED=true
TRACING_SAMPLE_RATE=0.1

# ============================================================================
# E2B SANDBOX SPECIFIC
# ============================================================================

E2B_SANDBOX_COUNT=4
E2B_AUTO_SCALING=true
E2B_MAX_INSTANCES=10
E2B_CPU_CORES=4
E2B_MEMORY_GB=8
E2B_DISK_GB=50
E2B_TIMEOUT_SECONDS=3600

# ============================================================================
# DEVPOD / DOCKER SPECIFIC
# ============================================================================

DOCKER_COMPOSE_PROJECT=ericsson-ran-swarm
DOCKER_NETWORK=swarm-network
DEVPOD_WORKSPACE=/workspace
DEVPOD_DATA_DIR=/workspace/data

# ============================================================================
# CLAUDE CODE WEB SPECIFIC
# ============================================================================

CLAUDE_CODE_WEB_ENABLED=true
CLAUDE_CODE_SESSION_TIMEOUT_MS=3600000
CLAUDE_CODE_MAX_TOKENS=200000
CLAUDE_CODE_TEMPERATURE=0.7

# ============================================================================
# PERFORMANCE TARGETS
# ============================================================================

CHAOS_DETECTION_LATENCY_MS=10
TRAFFIC_FORECAST_LATENCY_MS=1
ANOMALY_DETECTION_MODE=realtime
RCA_LATENCY_MS=500
SAFETY_VERIFICATION_LATENCY_MS=420
SANDBOX_STARTUP_LATENCY_MS=150
