# ============================================================================
# Ericsson RAN Swarm Optimizer - Environment Configuration
# ============================================================================
# AI Provider Credentials
# ============================================================================

# Claude Code Pro Max (Anthropic)
# Account: cedricableml@gmail.com
ANTHROPIC_API_KEY=${ANTHROPIC_API_KEY}

# OpenRouter API (Multi-model access)
OPENROUTER_API_KEY=${OPENROUTER_API_KEY}

# Google Gemini 3 Pro
# Account: cedricable@gmail.com
GEMINI_API_KEY=${GEMINI_API_KEY}

# E2B (Code Execution Sandbox)
E2B_API_KEY=${E2B_API_KEY}

# ============================================================================
# Default Model Configuration
# ============================================================================

# Primary AI Model (Claude Pro Max)
PRIMARY_MODEL=claude-3-5-sonnet-20241022
PRIMARY_PROVIDER=anthropic

# Secondary AI Model (Gemini 3 Pro)
SECONDARY_MODEL=gemini-2.0-flash-exp
SECONDARY_PROVIDER=google

# Fallback Model (OpenRouter)
FALLBACK_MODEL=anthropic/claude-3.5-sonnet
FALLBACK_PROVIDER=openrouter

# ============================================================================
# Swarm Configuration
# ============================================================================

# Swarm Identity
SWARM_CLUSTER_ID=ericsson-ran-cluster-01
SWARM_NODE_ID=node-${HOSTNAME:-local}

# Federation Settings
FEDERATION_ENABLED=true
FEDERATION_ALGORITHM=FedAvg
FEDERATION_MIN_CLIENTS=3
FEDERATION_ROUND_INTERVAL_MS=300000

# ============================================================================
# RAN Optimization Settings
# ============================================================================

# Optimization Granularities (comma-separated)
OPTIMIZATION_GRANULARITIES=15min,1hour,1day,1week

# Safety Guardrails
MAX_POWER_DBM=46
MIN_POWER_DBM=-10
MAX_P0_DBM=-60
MIN_P0_DBM=-126
MAX_ALPHA=1.0
MIN_ALPHA=0.4

# RL Agent Settings
RL_ALGORITHM=DecisionTransformer
RL_CONTEXT_LENGTH=20
RL_LEARNING_RATE=0.0001

# ============================================================================
# Security Settings
# ============================================================================

# AIDefence Configuration
AIDEFENCE_ENABLED=true
ADVERSARIAL_DETECTION=true
GUARDRAILS_ENABLED=true
MODEL_PROVENANCE=true

# Differential Privacy
DP_ENABLED=true
DP_EPSILON=1.0
DP_DELTA=1e-5

# ============================================================================
# Monitoring & Logging
# ============================================================================

# Logging Level (debug, info, warn, error)
LOG_LEVEL=info

# Metrics
METRICS_PORT=9090
HEALTH_CHECK_PORT=8080

# Tracing
TRACING_ENABLED=true

# ============================================================================
# Database Configuration
# ============================================================================

# SQLite (Default)
DATABASE_TYPE=sqlite
DATABASE_PATH=./data/swarm.db

# Vector Store (HNSW)
VECTOR_STORE_DIMENSIONS=768
VECTOR_STORE_EF_CONSTRUCTION=200
VECTOR_STORE_M=16

# ============================================================================
# API Server Configuration
# ============================================================================

API_PORT=3000
API_HOST=0.0.0.0
CORS_ORIGIN=*

# ============================================================================
# Claude Flow Integration
# ============================================================================

CLAUDE_FLOW_ENABLED=true
HIVE_MIND_ENABLED=true
REASONING_BANK_ENABLED=true
