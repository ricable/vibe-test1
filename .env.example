# Ericsson RAN Autonomous Swarm - Environment Configuration

# CORE ORCHESTRATION
ORCHESTRATION_ENGINE=agentic-flow
CLAUDE_FLOW_ENABLED=true
AGENT_COUNT=66
LOG_LEVEL=debug
NODE_ENV=development

# E2B SANDBOXES
E2B_ENABLED=true
E2B_SANDBOX_COUNT=4
E2B_PLATFORM=linux-x64-gnu
E2B_SANDBOX_TIMEOUT=3600
E2B_RESOURCE_CPU=4
E2B_RESOURCE_MEMORY=8GB
E2B_RESOURCE_DISK=50GB

# RAN OPTIMIZATION
RAN_ENABLED=true
RAN_OPTIMIZATION_INTERVAL=300
RAN_METRICS_COLLECTION_INTERVAL=30
RAN_KPI_THRESHOLD_THROUGHPUT=85
RAN_KPI_THRESHOLD_LATENCY=50
RAN_ENERGY_TARGET=1.6

# MEMORY & VECTOR DATABASE
AGENTDB_ENABLED=true
VECTOR_DB_BACKEND=ruvector
VECTOR_DB_INDEX_TYPE=hnsw
MEMORY_PERSISTENCE=true
MEMORY_BACKUP_INTERVAL=3600
MEMORY_MAX_SIZE=10GB

# LLM CONFIGURATION
LLM_ROUTER_ENABLED=true
LLM_PRIMARY_PROVIDER=anthropic
LLM_FALLBACK_PROVIDER=openai
LLM_ADAPTIVE_ROUTING=true
OPENAI_API_KEY=your-key-here
ANTHROPIC_API_KEY=your-key-here
GOOGLE_API_KEY=your-key-here

# LEARNING & OPTIMIZATION
DSPY_LEARNING_ENABLED=true
SELF_LEARNING_RATE=0.5
LEARNING_CHECKPOINTS_DIR=./data/learning/checkpoints
LEARNING_METRICS_DIR=./data/learning/metrics

# SWARM INTELLIGENCE
SWARM_TOPOLOGY=hierarchical
SWARM_COORDINATION_MODE=mesh
NANO_AGENT_SWARM_ENABLED=true
NANO_AGENT_COUNT=1000
SWARM_HEARTBEAT_INTERVAL=5000

# MONITORING & OBSERVABILITY
PROMETHEUS_ENABLED=true
PROMETHEUS_PORT=9090
LOGGING_BACKEND=pino
LOG_DIR=./logs
MONITORING_ENABLED=true
MONITORING_INTERVAL=60

# SECURITY
SECURITY_ENABLED=true
AIDEFENCE_ENABLED=true
QUANTUM_RESISTANT_CRYPTO=true
ENCRYPTION_ALGORITHM=AES-256-GCM
SSL_ENABLED=true

# STORAGE
DATABASE_URL=sqlite:./data/swarm.db
CACHE_BACKEND=ioredis
REDIS_URL=redis://localhost:6379
DATA_DIR=./data
BACKUP_DIR=./backups

# DEVELOPMENT
DEBUG_ENABLED=false
MOCK_E2B=false
MOCK_RAN_METRICS=false
PERFORMANCE_PROFILING=false

# DEPLOYMENT
DEPLOYMENT_ENVIRONMENT=development
DEPLOYMENT_REGION=local
SERVICE_PORT=3000
API_PORT=3001
DASHBOARD_PORT=3002

# ADVANCED
WASM_OPTIMIZATION=true
SIMD_ACCELERATION=true
MULTI_THREADING=true
MAX_CONCURRENT_TASKS=32
