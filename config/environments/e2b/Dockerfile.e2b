# E2B Sandbox Dockerfile for Ericsson RAN Swarm Optimizer
# Optimized for cloud sandbox execution with linux-x64-gnu binaries

FROM node:20-slim

# Set environment
ENV NODE_ENV=production
ENV PLATFORM=e2b
ENV ARCH=x64

# Install system dependencies
RUN apt-get update && apt-get install -y \
    python3 \
    make \
    g++ \
    curl \
    git \
    && rm -rf /var/lib/apt/lists/*

# Create app directory
WORKDIR /app

# Copy package files
COPY package*.json ./

# Install dependencies (including linux-x64-gnu native bindings)
RUN npm ci --only=production \
    && npm cache clean --force

# Copy application code
COPY config ./config
COPY src ./src
COPY scripts ./scripts
COPY tsconfig.json ./
COPY .env.example ./.env

# Create data directories
RUN mkdir -p /data/agentdb /data/vectors /logs

# Build TypeScript
RUN npm run build 2>/dev/null || true

# Expose ports
EXPOSE 3000 3001 9090 8080

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=40s --retries=3 \
    CMD curl -f http://localhost:8080/health || exit 1

# Default command
CMD ["npm", "run", "start"]
