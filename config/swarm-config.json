{
  "swarm": {
    "name": "ericsson-ran-swarm",
    "version": "2.0.0",
    "topology": "mesh",
    "maxAgentsPerCluster": 256,
    "heartbeatIntervalMs": 1000,
    "leaderElectionTimeoutMs": 5000,
    "consensusProtocol": "strange-loops",
    "communicationProtocol": "QUIC"
  },
  "federation": {
    "enabled": true,
    "aggregationAlgorithm": "FedAvg",
    "minClientsPerRound": 3,
    "roundIntervalMs": 300000,
    "privacyMode": "differential",
    "epsilonBudget": 1.0,
    "modelCompression": {
      "enabled": true,
      "method": "topK",
      "compressionRatio": 0.1
    }
  },
  "agentdb": {
    "version": "1.6.1",
    "storage": {
      "type": "sqlite",
      "path": "./data/agentdb",
      "maxSizeMB": 512
    },
    "reasoningBank": {
      "maxTrajectories": 10000,
      "reflexionEnabled": true,
      "causalGraphDepth": 10
    },
    "vectorSearch": {
      "algorithm": "HNSW",
      "dimensions": 768,
      "efConstruction": 200,
      "M": 16,
      "efSearch": 100
    }
  },
  "ruvector": {
    "version": "0.1.31",
    "gnn": {
      "type": "ST-GNN",
      "layers": 4,
      "hiddenDimension": 256,
      "attentionHeads": 8,
      "attentionType": "flash",
      "dropout": 0.1
    },
    "hypergraph": {
      "enabled": true,
      "maxHyperedgeSize": 16
    },
    "sona": {
      "enabled": true,
      "loraEnabled": true,
      "ewcEnabled": true,
      "reasoningBankEnabled": true
    },
    "router": {
      "type": "semantic",
      "algorithm": "HNSW",
      "intentMatching": true
    }
  },
  "claudeFlow": {
    "version": "2.7.41",
    "enabled": true,
    "hiveMind": {
      "enabled": true,
      "topology": "mesh"
    },
    "sparc": {
      "enabled": true,
      "modes": ["spec-pseudocode", "architect", "tdd", "integration"]
    },
    "mcp": {
      "enabled": true,
      "servers": ["claude-flow", "ruv-swarm", "strange-loops-mcp"]
    }
  },
  "ranOptimization": {
    "cm": {
      "enabled": true,
      "planner": "GOAP",
      "safetyVerification": "LTL",
      "rollbackEnabled": true,
      "maxConcurrentChanges": 5,
      "managedObjects": [
        "EUtranCellFDD",
        "NRCellDU",
        "NRCellCU",
        "RetDevice",
        "ReportConfigEUtra",
        "Beamforming"
      ]
    },
    "pm": {
      "enabled": true,
      "chaosDetection": {
        "enabled": true,
        "lyapunovThreshold": 0.05,
        "embeddingDimension": 5,
        "latencyTargetMs": 10
      },
      "forecasting": {
        "model": "LSTM",
        "horizonMs": 900000,
        "latencyTargetMs": 1
      },
      "energySaving": {
        "enabled": true
      }
    },
    "fm": {
      "enabled": true,
      "anomalyDetection": {
        "type": "fast-path",
        "mode": "realtime"
      },
      "rca": {
        "engine": "neuro-symbolic",
        "latencyTargetMs": 500
      },
      "alarmCorrelation": {
        "enabled": true
      },
      "selfHealing": {
        "enabled": true
      }
    },
    "granularities": ["15min", "1hour", "1day", "1week"],
    "safetyGuardrails": {
      "maxPowerDbm": 46,
      "minPowerDbm": -10,
      "maxP0Dbm": -60,
      "minP0Dbm": -126,
      "maxAlpha": 1.0,
      "minAlpha": 0.4
    },
    "rl": {
      "algorithm": "DecisionTransformer",
      "contextLength": 20,
      "hiddenSize": 256,
      "numHeads": 4,
      "numLayers": 3,
      "maxEpLength": 1000,
      "learningRate": 0.0001,
      "batchSize": 64,
      "warmupSteps": 10000
    }
  },
  "agents": {
    "types": [
      {
        "name": "cm-agent",
        "type": "configurator",
        "role": "Configuration Management",
        "capabilities": ["GOAP planning", "LTL verification", "atomic rollback"],
        "priority": "high"
      },
      {
        "name": "pm-agent",
        "type": "optimizer",
        "role": "Performance Management",
        "capabilities": ["chaos detection", "LSTM forecasting", "energy optimization"],
        "priority": "high"
      },
      {
        "name": "fm-agent",
        "type": "healer",
        "role": "Fault Management",
        "capabilities": ["anomaly detection", "neuro-symbolic RCA", "alarm correlation", "self-healing"],
        "priority": "critical"
      },
      {
        "name": "gnn-agent",
        "type": "analyzer",
        "role": "Spatial Intelligence",
        "capabilities": ["cell embeddings", "PCI graph coloring", "handover loop detection"],
        "priority": "medium"
      },
      {
        "name": "coordinator",
        "type": "queen",
        "role": "Swarm Coordination",
        "capabilities": ["federated learning", "consensus building", "task orchestration"],
        "priority": "critical"
      }
    ]
  },
  "security": {
    "aidefence": {
      "version": "2.1.1",
      "adversarialDetection": true,
      "inputValidation": true,
      "modelProvenance": true,
      "guardrails": true
    },
    "differentialPrivacy": {
      "enabled": true,
      "epsilon": 1.0,
      "delta": 1e-5
    },
    "cryptography": {
      "signatureAlgorithm": "Ed25519",
      "encryptionAlgorithm": "AES-256-GCM"
    }
  },
  "monitoring": {
    "metricsPort": 9090,
    "healthCheckPort": 8080,
    "loggingLevel": "info",
    "loggingFormat": "json",
    "tracingEnabled": true,
    "tracingSampleRate": 0.1
  },
  "platforms": {
    "e2b": {
      "enabled": true,
      "sandboxCount": 4,
      "autoScaling": true,
      "maxInstances": 10,
      "cpuCores": 4,
      "memoryGb": 8,
      "timeoutSeconds": 3600
    },
    "devpod": {
      "enabled": true,
      "architecture": "arm64",
      "dockerCompose": true,
      "redisEnabled": true,
      "prometheusEnabled": true,
      "grafanaEnabled": true
    },
    "claudeWeb": {
      "enabled": true,
      "sessionTimeoutMs": 3600000,
      "maxTokens": 200000
    }
  }
}
